PORT=3002
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/deepseek_monitor
DEEPSEEK_BASE_URL=https://api.deepseek.com
ADMIN_TOKEN=local-dev-token
KEY_HASH_SECRET=change-this-local-development-secret
PRICE_PER_MILLION_IDR=50000
# Optional comma-separated browser origins allowed to call the API
CORS_ORIGINS=

# SingaPay QRIS top-ups (custom HTTPS reverse-proxy URLs and path prefixes are supported)
# Example: https://singapay.nagatech.id/sandbox
SINGAPAY_BASE_URL=https://sandbox-payment-b2b.singapay.id
SINGAPAY_CLIENT_ID=
SINGAPAY_CLIENT_SECRET=
SINGAPAY_PARTNER_ID=
SINGAPAY_ACCOUNT_ID=
# Register https://deepseek.nagatech.id/api/webhooks/singapay as the merchant callback URL.
